NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# Optional: private API URL for server-side requests from the Next.js container,
# for example when it cannot reach the API through NEXT_PUBLIC_API_URL.
# If unset, NEXT_PUBLIC_API_URL is used.
INTERNAL_API_URL=http://tickr-api-container:3000

# Auth providers
NEXTAUTH_URL=http://127.0.0.1:3000
# Use openssl rand -base64 32
NEXTAUTH_SECRET=
# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=